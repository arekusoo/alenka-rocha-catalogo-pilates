# VITE_SUPABASE_URL: Project URL from Supabase (Project Settings > API).
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# VITE_SUPABASE_KEY: Publishable (anon) API key from Supabase (Project Settings > API).
# This key is meant to be public; access is controlled by Row Level Security policies.
VITE_SUPABASE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
